# Gemini API Key — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Graph8 Live Credentials — get from https://app.graph8.com/settings/api
G8_API_KEY=g8_live_your_key_here
G8_BASE_URL=https://be.graph8.com/api/v1
G8_USER_EMAIL=your_email@example.com
G8_SEQUENCE_ID=your_sequence_id_here
G8_STEP_ID=your_step_id_here

# Server Port
PORT=3001
